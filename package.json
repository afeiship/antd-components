{
  "name": "antd-components",
  "version": "1.0.0",
  "description": "Antd wrapped components.",
  "homepage": "https://js.work",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm run dev:example",
    "dev:lib": "pnpm --filter @jswork/antd-components run dev",
    "dev:example": "pnpm --filter example run dev",
    "dev:docs": "pnpm --filter dumi-docs run dev",
    "build": "pnpm run ln:build",
    "ln:build": "pnpm --filter @jswork/antd-components run build",
    "release": "pnpm run ln:publish",
    "ln:publish": "pnpm --filter @jswork/antd-components run release"
  }
}
